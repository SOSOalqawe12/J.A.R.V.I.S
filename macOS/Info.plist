<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>JARVIS</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>NSHumanReadableCopyright</key>
	<string>Personal assistant build.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>JARVIS listens when you click the microphone or press ⌃⌥V so you can talk instead of typing.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>JARVIS turns your speech into text so it can follow your requests.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>JARVIS controls other apps (Safari, Notes, Music, Finder…) only when you approve an action.</string>
	<key>NSScreenCaptureUsageDescription</key>
	<string>JARVIS looks at your screen to understand what you're doing and suggest next steps.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>JARVIS adds events to your calendar and reads your schedule when you ask.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>JARVIS adds events to your calendar and reads your schedule when you ask.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>JARVIS adds and reads reminders when you ask.</string>
	<key>NSRemindersUsageDescription</key>
	<string>JARVIS adds and reads reminders when you ask.</string>
	<key>NSLocationUsageDescription</key>
	<string>JARVIS uses your approximate location for weather questions.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>JARVIS uses your approximate location for weather questions.</string>
	<!-- Local model servers (Ollama, LM Studio…) usually speak plain http on your network. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSContactsUsageDescription</key>
	<string>JARVIS looks up phone numbers and emails when you ask it to message or email someone.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
